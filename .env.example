# --- Meta WhatsApp Cloud API ---
WHATSAPP_TOKEN=changeme
WHATSAPP_PHONE_NUMBER_ID=changeme
APP_SECRET=changeme
VERIFY_TOKEN=changeme-a-long-random-string
GRAPH_VERSION=v21.0

# --- Database ---
DATABASE_URL=postgresql+psycopg://kora:kora@db:5432/koradesk

# --- App ---
ENV=dev
# Allowed: dev, prod, production. Production requires PostgreSQL and non-placeholder
# APP_SECRET / VERIFY_TOKEN values of at least 32 characters each.
# Set real WhatsApp credentials separately before enabling the legacy integration.
DAILY_SUMMARY_HOUR=18
RETENTION_MONTHS=18

# --- Ops mail (comma-separated; add recipients any time, no code change) ---
ADMIN_EMAILS=hello@koradesk.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Kora Desk Ops <ops@koradesk.com>
SMTP_TLS=true
